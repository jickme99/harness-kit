{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/az_guard.py\"",
            "timeout": 15,
            "statusMessage": "az subscription guard"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/git_scope_guard.py\"",
            "timeout": 15,
            "statusMessage": "git scope guard"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/merge_green_check.py\"",
            "timeout": 45,
            "statusMessage": "merge-green guard"
          }
        ]
      }
    ]
  }
}
